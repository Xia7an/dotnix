/**
 * ROFI Launchpad Theme
 * macOS Launchpad-style grid layout
 * Catppuccin Mocha color scheme
 */

* {
    background-color: transparent;
    text-color: #cdd6f4;
    font: "SF Pro Display 12";
}

configuration {
    show-icons: true;
    display-drun: "";
}

window {
    background-color: #1e1e2eee;
    border: 0px;
    border-radius: 24px;
    padding: 30px;

    width: 1600px;
    height: 1000px;

    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    spacing: 20px;
    children: [inputbar, listview];
}

/* Search bar - macOS style */
inputbar {
    background-color: #313244;
    text-color: #cdd6f4;
    border-radius: 12px;
    padding: 12px 20px;
    margin: 0px 300px 10px 300px;
    children: [textbox-prompt, entry];
    spacing: 10px;
}

textbox-prompt {
    expand: false;
    str: "🔍";
    padding: 0px 5px 0px 0px;
    text-color: #6c7086;
}

entry {
    background-color: transparent;
    text-color: #cdd6f4;
    placeholder: "Search Apps...";
    placeholder-color: #6c7086;
}

/* Grid view */
listview {
    background-color: transparent;
    padding: 20px 40px;
    spacing: 15px;
    columns: 7;
    lines: 4;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
}

/* Individual app entry */
element {
    background-color: transparent;
    orientation: vertical;
    border-radius: 16px;
    padding: 15px 10px;
    spacing: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: #89b4fa4D;
    border-radius: 16px;
}

element selected.active {
    background-color: #a6e3a14D;
}

element selected.urgent {
    background-color: #f38ba84D;
}

element normal.active {
    text-color: #a6e3a1;
}

element normal.urgent {
    text-color: #f38ba8;
}

element alternate.normal {
    background-color: transparent;
}

element alternate.active {
    text-color: #a6e3a1;
}

element alternate.urgent {
    text-color: #f38ba8;
}

/* App icon - centered above text */
element-icon {
    background-color: transparent;
    size: 64px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}

/* App name - centered below icon */
element-text {
    background-color: transparent;
    text-color: #cdd6f4;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "SF Pro Display 11";
}

element selected.normal element-text {
    text-color: #ffffff;
    font: "SF Pro Display Bold 11";
}

/* Error message */
error-message {
    background-color: #f38ba8;
    text-color: #1e1e2e;
    border-radius: 12px;
    padding: 15px;
}

message {
    background-color: transparent;
    text-color: #cdd6f4;
}